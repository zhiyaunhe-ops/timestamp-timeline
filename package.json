{
  "name": "obsidian-timestamp-timeline",
  "version": "1.2.0",
  "description": "Auto timestamp while writing, plus a vault-wide timeline of every dated line. No AI involved.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "scan:vault": "node tests/run.mjs tests/vault-scan.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "timestamp",
    "timeline",
    "journal",
    "todo",
    "tasks"
  ],
  "author": "ZY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhiyaunhe-ops/timestamp-timeline.git"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.21.5",
    "obsidian": "^1.7.2",
    "typescript": "^5.5.3"
  }
}
